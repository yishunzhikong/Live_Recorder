<ContentDialog
    x:Class="LiveRecorder.ToolVersionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="工具版本管理"
    CloseButtonText="关闭"
    Closing="Dialog_Closing"
    Loaded="Dialog_Loaded">
    <StackPanel MinWidth="380" Spacing="12">
        <ComboBox x:Name="ToolBox" Header="工具" SelectionChanged="Tool_Changed">
            <ComboBoxItem Content="FFmpeg" />
            <ComboBoxItem Content="yt-dlp" />
        </ComboBox>
        <StackPanel Spacing="4">
            <TextBlock x:Name="ActiveVersion" />
            <ListView x:Name="VersionList" DisplayMemberPath="Label" SelectionChanged="Version_Changed"
                      AutomationProperties.Name="已安装版本" MaxHeight="144" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="UseButton" Content="使用此版本" Click="Use_Click" />
                <Button x:Name="AutoButton" Content="自动选择" Click="Auto_Click" />
                <Button x:Name="DeleteButton" Content="删除">
                    <Button.Flyout>
                        <Flyout x:Name="DeleteFlyout" Opening="Delete_Opening">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="DeleteMessage" TextWrapping="Wrap" MaxWidth="270" />
                                <Button Content="确认删除" Click="Delete_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </StackPanel>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="AvailableVersions" Header="可安装版本" PlaceholderText="选择版本"
                      HorizontalAlignment="Stretch" SelectionChanged="Version_Changed" />
            <Button x:Name="InstallButton" Grid.Column="1" VerticalAlignment="Bottom" Content="安装版本" Click="Install_Click" />
            <Button x:Name="MoreButton" Grid.Column="2" VerticalAlignment="Bottom" Content="更多版本" Click="More_Click" />
            <Button x:Name="RefreshButton" Grid.Column="3" VerticalAlignment="Bottom" Content="刷新" Click="Refresh_Click" />
        </Grid>
        <ProgressBar x:Name="InstallProgress" Visibility="Collapsed" />
        <InfoBar x:Name="MessageBar" IsClosable="False" />
    </StackPanel>
</ContentDialog>
