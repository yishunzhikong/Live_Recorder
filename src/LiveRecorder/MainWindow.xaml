<Window
    x:Class="LiveRecorder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Live Recorder">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="16" ColumnSpacing="16">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel Padding="20" Spacing="16">
                    <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBox x:Name="SourceBox" Header="媒体链接" PlaceholderText="HTTP、M3U8、RTSP、RTMP 或 RTP"
                             InputScope="Url" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputBox" Header="保存到" PlaceholderText="输出文件夹" />
                        <Button x:Name="OutputPickerButton" Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Click="PickOutput_Click" />
                    </Grid>
                    <ComboBox x:Name="EncoderBox" Header="H.264 编码器" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="软件 · x264" />
                        <ComboBoxItem Content="Intel · Quick Sync" />
                        <ComboBoxItem Content="NVIDIA · NVENC" />
                        <ComboBoxItem Content="AMD · AMF" />
                    </ComboBox>
                    <NumberBox x:Name="PartSizeBox" Header="录制分片大小（MB）" Value="1" Minimum="1" Maximum="1024"
                               SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" />
                    <CheckBox x:Name="ReencodeBox">
                        <TextBlock Text="合并时使用所选编码器重新编码" TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border CornerRadius="12" Background="#14161C" Padding="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="媒体预览" Foreground="White" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="PreviewName" Grid.Column="1" Foreground="#C1C5D0"
                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Grid.Row="1" Background="#090A0C" Margin="5,0,5,5" CornerRadius="8">
                        <MediaPlayerElement x:Name="PreviewPlayer" Stretch="Uniform" Visibility="Collapsed"
                                            AreTransportControlsEnabled="True" />
                        <StackPanel x:Name="PreviewPlaceholder" MaxWidth="480" Margin="18" Spacing="9"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" Foreground="#B3B9C8" FontSize="22" />
                            <TextBlock x:Name="PreviewMessage" Text="选择预览链接或打开本地视频。" Foreground="#E3E5ED"
                                       TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <StackPanel Padding="16" Spacing="10">
                        <TextBlock Text="操作" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PreviewLinkButton" Content="预览链接" Click="PreviewLink_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="PlayFileButton" Content="播放本地视频…" Click="PlayFile_Click" />
                            <Button x:Name="PlayResultButton" Content="播放结果" Click="PlayResult_Click" IsEnabled="False" />
                            <Button x:Name="StopPreviewButton" Content="关闭预览" Click="StopPreview_Click" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DownloadButton" Content="下载视频" Click="Download_Click" />
                            <Button x:Name="RecordButton" Content="录制直播" Click="Record_Click" />
                            <Button x:Name="SdpButton" Content="从 SDP 录制" Click="RecordSdp_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="MergeButton" Content="合并录制分片…" Click="Merge_Click" />
                            <Button x:Name="TranscodeButton" Content="转码视频…" Click="Transcode_Click" />
                        </StackPanel>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="0,10,0,0">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusTitle" Text="就绪" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="StopButton" Content="停止任务" Click="Stop_Click" IsEnabled="False" />
                                        <Button x:Name="OpenOutputButton" Content="打开文件夹" Click="OpenOutput_Click" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
                                <TextBlock x:Name="StatusDetail" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
