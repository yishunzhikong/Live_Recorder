<Window
    x:Class="LiveRecorder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiveRecorder"
    Title="Live Recorder">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Viewbox Stretch="Uniform">
            <Grid x:Name="MainLayout">
                <Grid Padding="16,4,16,16" ColumnSpacing="16" RowSpacing="8">
                    <!-- 左侧集中设置，右侧预览和操作区使用两倍列宽。 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 工具安装与全局选项对两种媒体模式共用。 -->
                    <MenuBar x:Name="ToolsMenu" Grid.ColumnSpan="2">
                        <MenuBarItem Title="工具">
                            <MenuFlyoutItem Text="安装 / 升级 FFmpeg…" Click="UpgradeFfmpeg_Click" />
                            <MenuFlyoutItem Text="安装 / 升级 yt-dlp…" Click="UpgradeYtDlp_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="工具版本管理…" Click="ManageToolVersions_Click" />
                        </MenuBarItem>
                        <MenuBarItem Title="选项">
                            <MenuFlyoutItem Text="保存到…" Click="OutputOptions_Click" />
                            <MenuFlyoutItem Text="编码设置…" Click="EncodingOptions_Click" />
                            <MenuFlyoutItem Text="断流重连设置…" Click="ReconnectOptions_Click" />
                            <MenuFlyoutItem Text="日志设置…" Click="LogOptions_Click" />
                        </MenuBarItem>
                    </MenuBar>

                    <!-- 左栏只切换输入与模式专属设置，右栏控件保持共用。 -->
                    <Border x:Name="SettingsCard" Grid.Row="1" Style="{StaticResource PanelCardStyle}" VerticalAlignment="Top">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                            <StackPanel Padding="20" Spacing="16">
                                <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
                                <ComboBox x:Name="ModeBox" Header="模式" HorizontalAlignment="Stretch" SelectedIndex="0">
                                    <ComboBoxItem Content="直播录制" />
                                    <ComboBoxItem Content="yt-dlp" />
                                </ComboBox>
                                <TextBox x:Name="SourceBox" Header="媒体链接" PlaceholderText="HTTP、M3U8、RTSP、RTMP 或 RTP"
                                         InputScope="Url" />
                                <StackPanel x:Name="WebSettings" Spacing="10" Visibility="Collapsed">
                                    <TextBox x:Name="WebSourceBox" Header="网页视频链接" PlaceholderText="粘贴包含视频的网页地址"
                                             InputScope="Url" TextChanged="WebSource_TextChanged" />
                                    <Button x:Name="AnalyzeWebButton" Content="分析链接" Click="AnalyzeWeb_Click" />
                                    <TextBlock x:Name="WebVideoTitle" TextWrapping="Wrap" />
                                    <ComboBox x:Name="WebFormatBox" Header="媒体格式" DisplayMemberPath="Label"
                                              PlaceholderText="选择格式" HorizontalAlignment="Stretch" IsEnabled="False"
                                              SelectionChanged="WebFormat_SelectionChanged" />
                                    <TextBox x:Name="WebLinkBox" Header="直链" IsReadOnly="True" TextWrapping="Wrap"
                                             Height="60" PlaceholderText="所选格式的地址将在这里显示" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <local:MediaPanel x:Name="MediaPane" Grid.Row="1" Grid.Column="1" />
                </Grid>
                <Grid x:Name="DialogLayer" />
            </Grid>
        </Viewbox>
    </Grid>
</Window>
