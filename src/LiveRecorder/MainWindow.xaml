<Window
    x:Class="LiveRecorder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Live Recorder">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Padding="28,24,28,12" MaxWidth="1020" HorizontalAlignment="Stretch" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="5">
                    <TextBlock Text="下载与录制" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="保存网络视频、分片录制直播，或处理已有媒体文件。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBox x:Name="SourceBox" Header="媒体链接" PlaceholderText="粘贴 HTTP、M3U8、RTSP、RTMP 或 RTP 链接"
                                 InputScope="Url" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DownloadButton" Content="下载视频" Click="Download_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="RecordButton" Content="录制直播" Click="Record_Click" />
                            <Button x:Name="SdpButton" Content="从 SDP 录制" Click="RecordSdp_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel Spacing="13">
                        <TextBlock Text="输出设置" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputBox" Header="保存到" PlaceholderText="输出文件夹" />
                            <Button x:Name="OutputPickerButton" Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Click="PickOutput_Click" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="EncoderBox" Header="H.264 编码器" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="软件 · x264" />
                                <ComboBoxItem Content="Intel · Quick Sync" />
                                <ComboBoxItem Content="NVIDIA · NVENC" />
                                <ComboBoxItem Content="AMD · AMF" />
                            </ComboBox>
                            <NumberBox x:Name="PartSizeBox" Grid.Column="1" Header="录制分片大小（MB）" Value="1" Minimum="1" Maximum="1024"
                                       SpinButtonPlacementMode="Compact" HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="本地文件" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="MergeButton" Content="合并录制分片…" Click="Merge_Click" />
                            <Button x:Name="TranscodeButton" Content="转码视频…" Click="Transcode_Click" />
                        </StackPanel>
                        <CheckBox x:Name="ReencodeBox" Content="合并时使用所选编码器重新编码" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1" MaxWidth="1020" Padding="28,4,28,20" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusTitle" Text="就绪" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" />
                            <Button x:Name="OpenOutputButton" Content="打开文件夹" Click="OpenOutput_Click" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
                    <ScrollViewer MaxHeight="104" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="StatusDetail" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
