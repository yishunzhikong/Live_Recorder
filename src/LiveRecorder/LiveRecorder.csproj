<Project Sdk="Microsoft.NET.Sdk">
  <!-- 桌面程序以 x64 非打包方式运行，并随输出提供 Windows App SDK 运行时。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.2.2-dev</Version>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../icon/icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- LibVLCSharp 提供预览控件，VideoLAN 包提供本地解码和播放运行时。 -->
    <PackageReference Include="LibVLCSharp.WinUI" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="../LiveRecorder.Core/LiveRecorder.Core.csproj" />
    <None Include="../../icon/icon.ico" Link="Assets/icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- WinUI copies compiled XAML to bin but can omit these files from an unpackaged publish. -->
  <Target Name="PublishCompiledXaml" BeforeTargets="GetCopyToPublishDirectoryItems"
          DependsOnTargets="AddProcessedXamlFilesToCopyLocal" Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <ContentWithTargetPath Include="@(_ProcessedXamlFilesToCopyLocalWithTargetPath)"
                             Condition="'%(_ProcessedXamlFilesToCopyLocalWithTargetPath.Extension)' == '.xbf'"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
